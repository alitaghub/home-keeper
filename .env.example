# Copy to .env (Git ignores it). Compose reads .env automatically.

# Agent model, only used with `--profile agent`. See docs/agent.md.
# AGENT_MODEL=azure:gpt-6.1-sol
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# For an openai: AGENT_MODEL instead of Azure.
# OPENAI_API_KEY=

# Host ports, all bound to 127.0.0.1.
# HOME_KEEPER_PORT=8000
# HA_PORT=8123
# AGENT_PORT=2026
# CHAT_PORT=3000

# Collection, all optional. See docs/collection.md.
# HOME_KEEPER_RETENTION_DAYS=30
# Seconds between collection passes, from 1 to 3600.
# HOME_KEEPER_RECONCILIATION_SECONDS=10
# HOME_KEEPER_TIMEZONE=UTC

# Your own Home Assistant, with compose.external.yaml. See docs/home-assistant.md.
# HOME_KEEPER_HA_URL=https://home-assistant.example.test:8123
# HOME_KEEPER_HA_TOKEN_FILE=/absolute/path/to/ha-token
# Optional: the address your browser uses, for the dashboard's link to Home Assistant.
# HOME_KEEPER_HA_PUBLIC_URL=https://home-assistant.example.test:8123
# Only with `--profile control`: the non-admin control user's token.
# HOME_KEEPER_HA_CONTROL_TOKEN_FILE=/absolute/path/to/ha-control-token

# Optional Telegram bot, used with `--profile agent --profile telegram`.
# Create the bot with BotFather. Allowed IDs are comma-separated numeric Telegram user IDs.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
# Optional: who may approve light commands. Empty means nobody. Each ID must also be allowed.
# TELEGRAM_CONTROL_USER_IDS=123456789
