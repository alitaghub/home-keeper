# Copy to .env (Git ignores it). Compose reads .env automatically.

# Agent model, only used with `--profile agent`. See docs/agent.md.
# AGENT_MODEL=azure:gpt-6.1-sol
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Host ports, all bound to 127.0.0.1.
# HOME_KEEPER_PORT=8000
# HA_PORT=8123
# AGENT_PORT=2026
# CHAT_PORT=3000

# Optional Telegram bot, used with `--profile agent --profile telegram`.
# Create the bot with BotFather. Allowed IDs are comma-separated numeric Telegram user IDs.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
